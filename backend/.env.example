NODE_ENV=development
PORT=3000

# PostgreSQL — xem mục "Kết nối Database" trong README của backend
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vivugo?schema=public"

# JWT — sinh bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SMTP cho email quên mật khẩu — để trống ở dev sẽ chỉ log link ra console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VivuGo <no-reply@vivugo.vn>"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
